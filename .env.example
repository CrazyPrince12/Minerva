# Copie ce fichier en `.env` et remplis la clé.
# Ne JAMAIS committer le fichier `.env` (il est dans `.gitignore`).

# Clé API Groq — https://console.groq.com/keys
GROQ_API_KEY=ta_cle_groq_ici

# Modèle (optionnel, valeur par défaut : openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Modèle de secours (optionnel, défaut : openai/gpt-oss-120b).
# Utilisé uniquement si le modèle principal renvoie 429/5xx/404.
# Mettre `none` pour désactiver complètement les secours.
# GROQ_FALLBACK_MODELS=openai/gpt-oss-120b

# Température (optionnel, défaut : 0.7)
GROQ_TEMPERATURE=0.7

# Max tokens de sortie (optionnel, défaut : 4096)
GROQ_MAX_TOKENS=4096

# Budget total de la requête côté serveur en ms (optionnel, défaut : 26000).
# Doit rester inférieur à maxDuration (30 s dans vercel.json).
# GROQ_DEADLINE_MS=26000

# ------------------------------------------------------------------
# OpenRouter — modèle sans filtre (Uncensored)
# https://openrouter.ai/cognitivecomputations/dolphin-mistral-24b-venice-edition:free
# ------------------------------------------------------------------

# Clé API OpenRouter — https://openrouter.ai/keys
# Astuce : GitHub bloque les push contenant une clé OpenRouter. Mets la vraie clé
# dans `.env.local` (ignoré par git, prioritaire sur `.env`) ou dans les variables
# d'environnement de Vercel/Render.
OPENROUTER_API_KEY=ta_cle_openrouter_ici

# Modèle OpenRouter par défaut (optionnel)
OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free

# Secours OpenRouter (optionnel, défaut : none = aucun secours)
# OPENROUTER_FALLBACK_MODELS=none

# Température / max tokens OpenRouter (optionnels, défauts : 0.7 / 4096)
# OPENROUTER_TEMPERATURE=0.7
# OPENROUTER_MAX_TOKENS=4096

# En-têtes optionnels de classement openrouter.ai (peuvent rester vides).
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
