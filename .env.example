# Copie ce fichier en `.env` et remplis la clé.
# Ne JAMAIS committer le fichier `.env` (il est dans `.gitignore`).

# Clé API Groq — https://console.groq.com/keys
GROQ_API_KEY=ta_cle_groq_ici

# Modèle principal (optionnel).
# Par défaut, si cette variable est vide : llama-3.3-70b-versatile (rapide et
# moins sujet aux 429 sur le palier gratuit) puis llama-3.1-8b-instant en secours.
# Pour revenir à l'ancien comportement : GROQ_MODEL=openai/gpt-oss-20b
# GROQ_MODEL=llama-3.3-70b-versatile

# Modèles de secours séparés par des virgules (optionnel).
# Utilisés automatiquement si le modèle principal renvoie 429/500/404.
# GROQ_FALLBACK_MODELS=llama-3.1-8b-instant,gemma2-9b-it

# Température (optionnel, défaut : 0.7)
# GROQ_TEMPERATURE=0.7

# Max tokens de sortie (optionnel, défaut : 2048)
# GROQ_MAX_TOKENS=2048

# Budget total de la requête côté serveur en ms (optionnel, défaut : 26000).
# Doit rester inférieur à maxDuration (30 s dans vercel.json).
# GROQ_DEADLINE_MS=26000
